# Copy to `backend/.env` for local dev (gitignored). In production these are
# set in the Railway service env — never committed.

# --- Database (local Postgres) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/terminalone
SPRING_DATASOURCE_USERNAME=terminalone
SPRING_DATASOURCE_PASSWORD=terminalone

# --- JWT signing (HS256 — must be >= 32 chars) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MINUTES=720

# --- Single V1 account (seeded on first startup) ---
APP_USER_USERNAME=trader
APP_USER_PASSWORD=change-me

# Railway injects PORT automatically; default 8080 locally.
# PORT=8080
